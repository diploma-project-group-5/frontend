# Усі змінні VITE_* потрапляють у збірку й видимі в браузері — секретів тут немає.

# Keycloak за маршрутом шлюзу /idp (KC_HTTP_RELATIVE_PATH=/idp)
VITE_KEYCLOAK_URL=/idp
VITE_KEYCLOAK_REALM=lad
VITE_KEYCLOAK_CLIENT_ID=web

# Префікс API шлюзу
VITE_API_BASE=/api/v1

# Лише для `npm run dev`: куди проксювати /api і /idp (стенд platform)
DEV_PROXY_TARGET=http://localhost
